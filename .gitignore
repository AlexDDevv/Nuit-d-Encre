# Fichiers de sauvegarde
*.bak
*.tmp
*.swp

# Dossiers OS
.DS_Store
Thumbs.db

# Répertoires de dépendances
node_modules/
vendor/

# Dossiers de construction
dist/
build/
bin/

# Fichiers de configuration spécifiques à l'IDE
.idea/
*.sublime-workspace
*.sublime-project
.vscode/
*.code-workspace
*.xcworkspace
*.swiftpm/
*.user
*.userprefs
*.suo
*.sln.docstates

# Fichiers de package et de verrouillage (dépend du gestionnaire de package utilisé)
yarn.lock
composer.lock
Gemfile.lock
Pipfile.lock

# Fichiers de log
*.log
npm-debug.log*
yarn-error.log*

# Fichiers de certificat
*.pem
*.cert
*.key

# Dossiers et fichiers de configuration d'environnement
.env
.env.local
.env.*.local
*.env

# Fichiers de base de données
*.sqlite
*.sqlite3
*.db

# Dossiers et fichiers de cache
.cache/
*.pyc
__pycache__/

# Documentation
# docs/* (et non docs/) : git ne peut pas ré-inclure un fichier dont un dossier
# parent est exclu. En excluant le contenu plutôt que le dossier, la règle de
# ré-inclusion ci-dessous devient applicable.
docs/*
*.md
# Les vraies docs projet (docs/*.md) sont versionnées. Les sous-dossiers de
# docs/ restent ignorés : specs et plans ne sont jamais commités.
!docs/*.md
# Le README de la racine est la vitrine du repo : toujours versionné.
!/README.md
# Contexte du projet (le « pourquoi »), public : toujours versionné.
!/CONTEXT.md
