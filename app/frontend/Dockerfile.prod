# --- Build stage ---
FROM node:24-alpine3.21 AS builder
WORKDIR /app
RUN corepack enable pnpm

# Dépendances (mêmes conventions que le Dockerfile de dev : pas de lockfile)
COPY package.json ./
RUN pnpm install

# Config de build + sources
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY vite.config.ts postcss.config.mjs index.html ./
COPY public ./public
COPY src ./src

# Les VITE_* sont inlinées dans le bundle au build : elles doivent être
# présentes ICI, pas au runtime du conteneur nginx. CapRover passe les
# Environmental Variables de l'app en --build-arg, mais Docker ne les expose
# au build que si un ARG les déclare : d'où la paire ARG/ENV ci-dessous.
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN pnpm build

# --- Runtime stage ---
FROM nginxinc/nginx-unprivileged:alpine AS runner
# Build statique
COPY --from=builder /app/dist /usr/share/nginx/html
# Template nginx (BACKEND_URL substitué au démarrage par l'entrypoint)
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 8080
