# Environnement (development | production)
NODE_ENV=development

# Application
APP_PORT=3310
APP_PORT_FRONTEND=http://localhost:5173

# Base de données
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=nuit_d_encre
POSTGRES_USER=nuit_d_encre
POSTGRES_PASSWORD=change_me

# Migrations : auto-run au démarrage (défaut). Poser "false" pour désactiver.
DB_MIGRATIONS_RUN=true

# JWT
JWT_SECRET=change_me

# Cookie
COOKIE_SECRET=change_me

# Utilisateur admin initial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_USERNAME=Admin
ADMIN_ROLE=admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# Google OAuth
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
